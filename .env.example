# ============================================
# Variables de entorno - JK Variedades
# Copia este archivo como .env y completa los valores
# NUNCA subas el archivo .env a GitHub
# ============================================

# Clave secreta de Django (usa una larga y aleatoria en producción)
SECRET_KEY=cambia-esto-por-una-clave-segura

# Activar modo debug (True en desarrollo, False en producción)
DEBUG=True

# Hosts permitidos, separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes permitidos para CORS (el frontend de React)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base de datos (en local se usa SQLite por defecto)
# DATABASE_URL=postgres://usuario:password@host:puerto/nombre_db

# Supabase Storage (producción - imágenes)
# AWS_STORAGE_BUCKET_NAME=product-imagenes
# AWS_S3_ENDPOINT_URL=https://xxxx.supabase.co/storage/v1/s3
# AWS_S3_REGION_NAME=auto
# AWS_ACCESS_KEY_ID=tu-access-key
# AWS_SECRET_ACCESS_KEY=tu-secret-key
# AWS_S3_CUSTOM_DOMAIN=xxxx.supabase.co/storage/v1/object/public/product-imagenes
